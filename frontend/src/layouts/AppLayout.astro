---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Sidebar from "@/components/Sidebar.astro";
import SEO from "@/components/SEO.astro";

interface Props {
    title: string;
    description?: string;
    active?: "home" | "discover" | "messages" | "settings";
}

const { title, description, active } = Astro.props;
const { user } = Astro.locals;
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <title>{title} · DevMatch</title>
        <SEO
            title={`${title} · DevMatch`}
            description={description ?? "Red social para desarrolladores: conectá con gente de tu stack."}
            noindex
        />
        <ClientRouter />
    </head>
    <body class="bg-bg text-white">
        <div class="flex min-h-dvh">
            <Sidebar
                active={active}
                username={user?.username ?? ""}
                fullName={user?.fullName ?? ""}
                avatarUrl={user?.avatarUrl ?? null}
            />
            <main class="min-w-0 flex-1 overflow-y-auto">
                <slot />
            </main>
        </div>
    </body>
</html>
