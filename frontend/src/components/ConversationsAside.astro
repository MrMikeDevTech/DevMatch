---
import Avatar from "@/components/Avatar.astro";

type Conversation = {
    id: string;
    otherUser: { id: string; username: string; fullName: string; avatarUrl: string | null };
    isFriends: boolean;
    lastMessage: { content: string; createdAt: string; isMine: boolean } | null;
    unreadCount: number;
    updatedAt: string;
};

interface Props {
    conversations: Conversation[];
    activeUsername?: string;
}

const { conversations, activeUsername } = Astro.props;
---

<aside class="flex h-full w-80 shrink-0 flex-col border-r border-border">
    <h1 class="border-b border-border px-5 py-4 text-lg font-bold text-white">Mensajes</h1>

    <div class="flex-1 overflow-y-auto">
        {
            conversations.length === 0 ? (
                <p class="px-5 py-8 text-center text-sm text-text-muted">
                    Todavía no tenés conversaciones. Visitá el perfil de alguien y tocá "Mensaje" para empezar una.
                </p>
            ) : (
                conversations.map((c) => (
                    <a
                        href={`/messages/${c.otherUser.username}`}
                        class={`flex items-center gap-3 border-b border-border px-4 py-3 hover:bg-surface-hover ${
                            activeUsername === c.otherUser.username ? "bg-primary/10" : ""
                        }`}
                    >
                        <Avatar src={c.otherUser.avatarUrl} alt={c.otherUser.fullName} size="md" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-semibold text-white">{c.otherUser.fullName}</span>
                                {c.isFriends && (
                                    <span class="shrink-0 rounded-full bg-primary/15 px-2 py-0.5 text-[10px] font-semibold text-primary">
                                        Amigos
                                    </span>
                                )}
                            </div>
                            <p class="truncate text-sm text-text-muted">
                                {c.lastMessage
                                    ? (c.lastMessage.isMine ? "Vos: " : "") + c.lastMessage.content
                                    : "Sin mensajes todavía"}
                            </p>
                        </div>
                        {c.unreadCount > 0 && (
                            <span class="shrink-0 rounded-full bg-primary px-2 py-0.5 text-xs font-bold text-black">
                                {c.unreadCount}
                            </span>
                        )}
                    </a>
                ))
            )
        }
    </div>
</aside>
