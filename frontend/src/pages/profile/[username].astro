---
import AppLayout from "@/layouts/AppLayout.astro";
import { backendJson } from "@/lib/api";
import { renderMarkdown } from "@/lib/markdown";
import Avatar from "@/components/Avatar.astro";
import TechBadge from "@/components/TechBadge.astro";
import PostList from "@/components/react/PostList";
import type { Post } from "@/components/react/PostCard";

type Profile = {
    id: string;
    username: string;
    fullName: string;
    avatarUrl: string | null;
    bannerUrl: string | null;
    bioMarkdown: string | null;
    professionalTitle: string | null;
    isVerified: boolean;
    technologies: Array<{ technology: { id: number; name: string } }>;
    _count: { followers: number; following: number; posts: number };
    isFollowing: boolean;
    isFollowedBy: boolean;
};

const { username } = Astro.params;
const { user } = Astro.locals;

const profileData = await backendJson<{ user: Profile }>(Astro.request, `/users/${username}`);

if (!profileData) {
    return Astro.redirect("/");
}

const profile = profileData.user;
const isOwnProfile = user?.username === profile.username;
const isFriends = profile.isFollowing && profile.isFollowedBy;
const readmeHtml = profile.bioMarkdown ? renderMarkdown(profile.bioMarkdown) : null;

const postsData = await backendJson<{ posts: Post[] }>(Astro.request, `/posts/by/${username}?limit=20`);
const posts = postsData?.posts ?? [];
---

<AppLayout title={profile.fullName}>
    <div class="mx-auto max-w-5xl">
        <div class="h-40 bg-gradient-to-br from-primary/20 to-surface-hover">
            {profile.bannerUrl && <img src={profile.bannerUrl} alt="" class="h-full w-full object-cover" />}
        </div>

        <div class="px-6">
            <div class="-mt-12 flex items-end justify-between">
                <Avatar
                    src={profile.avatarUrl}
                    alt={profile.fullName}
                    size="lg"
                    class="border-4 border-bg"
                    transition:name={`avatar-${profile.id}`}
                />
                {
                    isOwnProfile ? (
                        <a
                            href="/settings"
                            class="rounded-lg border border-border px-4 py-2 text-sm font-medium text-white hover:bg-surface-hover"
                        >
                            Editar perfil
                        </a>
                    ) : (
                        <div class="flex items-center gap-2">
                            <a
                                href={`/messages/${profile.username}`}
                                class="rounded-lg border border-border px-4 py-2 text-sm font-medium text-white hover:bg-surface-hover"
                            >
                                Mensaje
                            </a>
                            <button
                                id="follow-button"
                                data-username={profile.username}
                                data-following={profile.isFollowing ? "true" : "false"}
                                class="rounded-lg bg-primary px-5 py-2 text-sm font-bold text-black hover:brightness-90"
                            >
                                {profile.isFollowing ? "Siguiendo" : "Seguir"}
                            </button>
                        </div>
                    )
                }
            </div>

            <div class="mt-4">
                <p class="flex items-center gap-2 text-2xl font-bold text-white">
                    {profile.fullName}
                    {profile.isVerified && <span class="text-primary">✓</span>}
                    {isFriends && (
                        <span class="rounded-full bg-primary/15 px-2 py-0.5 text-xs font-semibold text-primary">
                            Amigos
                        </span>
                    )}
                </p>
                <p class="text-text-muted">@{profile.username}</p>
                {profile.professionalTitle && <p class="mt-1 text-sm text-white">{profile.professionalTitle}</p>}
            </div>

            <div class="mt-3 flex flex-wrap gap-2">
                {profile.technologies.map((entry) => <TechBadge name={entry.technology.name} />)}
            </div>

            <div class="mt-4 flex gap-6 text-sm">
                <span><strong class="text-white">{profile._count.followers}</strong> <span class="text-text-muted">Seguidores</span></span>
                <span><strong class="text-white">{profile._count.following}</strong> <span class="text-text-muted">Siguiendo</span></span>
                <span><strong class="text-white">{profile._count.posts}</strong> <span class="text-text-muted">Posts</span></span>
            </div>

            <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-[320px_1fr]">
                <div>
                    {
                        readmeHtml && (
                            <div class="rounded-xl border border-border bg-surface p-5">
                                <p class="mb-3 text-xs font-semibold tracking-wide text-text-muted uppercase">
                                    README.md
                                </p>
                                <div
                                    class="prose prose-sm prose-invert max-w-none text-sm text-white"
                                    set:html={readmeHtml}
                                />
                            </div>
                        )
                    }
                </div>

                <div>
                    <div class="border-b border-border">
                        <span class="inline-block border-b-2 border-primary px-1 pb-3 text-sm font-semibold text-white">
                            Posts
                        </span>
                    </div>
                    <PostList client:load posts={posts} />
                </div>
            </div>
        </div>
    </div>
</AppLayout>

<script>
    const BACKEND_URL = import.meta.env.PUBLIC_BACKEND_URL ?? "http://localhost:5001";
    const button = document.getElementById("follow-button") as HTMLButtonElement | null;
    button?.addEventListener("click", async () => {
        const username = button.dataset.username;
        const isFollowing = button.dataset.following === "true";
        button.disabled = true;
        const response = await fetch(`${BACKEND_URL}/users/${username}/follow`, {
            method: isFollowing ? "DELETE" : "POST",
            credentials: "include"
        });
        if (response.ok) {
            button.dataset.following = (!isFollowing).toString();
            button.textContent = !isFollowing ? "Siguiendo" : "Seguir";
        }
        button.disabled = false;
    });
</script>
