---
import AppLayout from "@/layouts/AppLayout.astro";
import { backendJson } from "@/lib/api";
import EditProfileForm from "@/components/react/EditProfileForm";

type Me = {
    username: string;
    avatarUrl: string | null;
    bannerUrl: string | null;
    fullName: string;
    professionalTitle: string | null;
    bioMarkdown: string | null;
};

const meData = await backendJson<{ user: Me }>(Astro.request, "/users/me");

if (!meData) {
    return Astro.redirect("/");
}
---

<AppLayout title="Editar perfil" active="settings">
    <div class="px-4 py-8 sm:px-6 sm:py-10">
        <h1 class="mb-6 text-2xl font-bold">Editar perfil</h1>
        <EditProfileForm client:load {...meData.user} />
        <div class="mx-auto mt-8 max-w-xl border-t border-border pt-6 md:hidden">
            <form method="post" action="/logout">
                <button
                    type="submit"
                    class="w-full rounded-lg border border-border px-4 py-2 text-left text-sm font-medium text-text-muted hover:bg-surface-hover hover:text-white"
                >
                    Cerrar sesión
                </button>
            </form>
        </div>
    </div>
</AppLayout>
