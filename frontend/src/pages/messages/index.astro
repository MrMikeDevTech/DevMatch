---
import AppLayout from "@/layouts/AppLayout.astro";
import { backendJson } from "@/lib/api";
import ConversationsAside from "@/components/ConversationsAside.astro";

type Conversation = {
    id: string;
    otherUser: { id: string; username: string; fullName: string; avatarUrl: string | null };
    isFriends: boolean;
    lastMessage: { content: string; createdAt: string; isMine: boolean } | null;
    unreadCount: number;
    updatedAt: string;
};

const data = await backendJson<{ conversations: Conversation[] }>(Astro.request, "/messages");
const conversations = data?.conversations ?? [];
---

<AppLayout title="Mensajes" active="messages">
    <div class="flex h-full overflow-hidden">
        <ConversationsAside conversations={conversations} />
        <div class="flex flex-1 items-center justify-center">
            <p class="text-sm text-text-muted">Elegí una conversación para empezar a chatear.</p>
        </div>
    </div>
</AppLayout>
